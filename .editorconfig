root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{fs,fsx,fsi}]
indent_style = space
indent_size = 4
max_line_length = 120
fsharp_multiline_bracket_style = aligned
fsharp_max_record_width = 80
fsharp_max_array_or_list_width = 80

[*.md]
trim_trailing_whitespace = false
